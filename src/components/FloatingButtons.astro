---
const wa = 'https://wa.me/573042225380?text=' + encodeURIComponent('Hola Edwin, vi tu portafolio y me gustaría hablar contigo.');
---

<a href={wa} target="_blank" rel="noopener noreferrer" class="fab" id="fab" aria-label="Escríbeme por WhatsApp">
  <svg width="26" height="26" viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.07-.3-.15-1.26-.46-2.39-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.07c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.7.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.18-1.41-.08-.13-.27-.2-.57-.35M12.05 21.8a9.87 9.87 0 0 1-5.03-1.38l-.36-.22-3.74.99 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.89-9.88a9.86 9.86 0 0 1 9.88 9.89c0 5.45-4.44 9.88-9.89 9.88m8.41-18.3A11.82 11.82 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.88 11.88 0 0 0 5.69 1.45c6.55 0 11.89-5.34 11.89-11.89 0-3.18-1.24-6.16-3.48-8.41"/></svg>
</a>

<style>
  .fab { position: fixed; right: 22px; bottom: 22px; z-index: 40; width: 56px; height: 56px; border-radius: 50%; display: grid; place-items: center; background: linear-gradient(135deg, #25d366, #128c7e); box-shadow: 0 12px 30px -8px rgba(37, 211, 102, .6); opacity: 0; transform: translateY(16px) scale(.9); pointer-events: none; transition: opacity .3s, transform .3s var(--ease); }
  .fab.show { opacity: 1; transform: none; pointer-events: auto; }
  .fab:hover { transform: scale(1.08); }
  @media (max-width: 560px) { .fab { right: 14px; bottom: 14px; width: 50px; height: 50px; } }
</style>

<script>
  const fab = document.getElementById('fab')!;
  const contact = document.getElementById('contact');
  let inContact = false;
  if (contact) new IntersectionObserver(([e]) => { inContact = e.isIntersecting; update(); }, { threshold: 0.2 }).observe(contact);
  const update = () => fab.classList.toggle('show', window.scrollY > 500 && !inContact);
  window.addEventListener('scroll', update, { passive: true });
  update();
</script>
