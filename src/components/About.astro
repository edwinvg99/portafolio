---
const pillars = [
  {
    t: { es: 'Plataformas web y SaaS', en: 'Web platforms & SaaS' },
    d: { es: 'Del modelo de datos al despliegue: autenticación, roles, pagos, paneles administrativos y reportes.', en: 'From data model to deployment: auth, roles, payments, admin dashboards and reporting.' },
  },
  {
    t: { es: 'Software para negocios reales', en: 'Software for real businesses' },
    d: { es: 'Sistemas a medida para operar el día a día: ventas, inventario, pedidos, reportes y migración de datos sin pérdidas.', en: 'Custom systems to run the day-to-day: sales, inventory, orders, reports and lossless data migration.' },
  },
  {
    t: { es: 'Automatización e integraciones', en: 'Automation & integrations' },
    d: { es: 'APIs de terceros, workers 24/7, scraping, webhooks, colas y apps de escritorio.', en: 'Third-party APIs, 24/7 workers, scraping, webhooks, queues and desktop apps.' },
  },
];

const groups = [
  { k: { es: 'Lenguajes', en: 'Languages' }, v: ['TypeScript', 'JavaScript', 'Python', 'PowerShell'] },
  { k: { es: 'Front-end', en: 'Front-end' }, v: ['React', 'Next.js', 'Astro', 'Vite', 'Tailwind CSS', 'Remotion'] },
  { k: { es: 'Back-end', en: 'Back-end' }, v: ['Node.js', 'Express', 'REST APIs', 'Workers', 'Django', 'Better Auth / JWT'] },
  { k: { es: 'Datos', en: 'Data' }, v: ['PostgreSQL', 'Prisma', 'Drizzle', 'MongoDB', 'MySQL', 'Redis'] },
  { k: { es: 'Cloud y DevOps', en: 'Cloud & DevOps' }, v: ['Railway', 'Cloudflare (Workers, R2)', 'Vercel', 'Docker', 'GitHub Actions', 'Git'] },
  { k: { es: 'Forma de trabajo', en: 'Ways of working' }, v: ['Scrum', 'Git Flow', 'UX/UI', 'Agentes de IA', 'Documentación'] },
];
---

<section id="about">
  <div class="container about">
    <div class="reveal">
      <p class="eyebrow"><span class="es-only">Sobre mí</span><span class="en-only">About</span></p>
      <h2 class="h2">
        <span class="es-only">Entiendo el problema, luego escribo el código.</span>
        <span class="en-only">I understand the problem first, then I write the code.</span>
      </h2>
      <p class="lead">
        <span class="es-only">Soy Ingeniero de Software del Tecnológico de Antioquia (Medellín). He construido plataformas que hoy usan miles de personas, sistemas a medida para negocios y herramientas que yo mismo uso a diario. Me muevo con comodidad entre el front-end, el back-end, la base de datos y el despliegue.</span>
        <span class="en-only">I'm a Software Engineer from Tecnológico de Antioquia (Medellín, Colombia). I've built platforms used by thousands of people, custom systems for businesses, and tools I use myself every day. I'm comfortable across front-end, back-end, databases and deployment.</span>
      </p>
      <div class="pillars">
        {pillars.map((p) => (
          <div class="pillar">
            <h3><span class="es-only">{p.t.es}</span><span class="en-only">{p.t.en}</span></h3>
            <p><span class="es-only">{p.d.es}</span><span class="en-only">{p.d.en}</span></p>
          </div>
        ))}
      </div>
    </div>

    <div class="skills card reveal reveal-d1">
      {groups.map((g) => (
        <div class="sk-row">
          <p class="sk-k"><span class="es-only">{g.k.es}</span><span class="en-only">{g.k.en}</span></p>
          <div class="sk-v">{g.v.map((s) => <span class="chip">{s}</span>)}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .about { display: grid; grid-template-columns: 1.1fr 1fr; gap: 64px; align-items: start; }
  .pillars { display: grid; gap: 18px; margin-top: 36px; }
  .pillar { padding-left: 18px; border-left: 2px solid rgba(255, 106, 43, .35); }
  .pillar h3 { font-family: var(--font-display); font-size: 1.08rem; margin-bottom: 4px; }
  .pillar p { color: var(--text-muted); font-size: .92rem; }
  .skills { padding: 10px 26px; }
  .sk-row { padding: 18px 0; }
  .sk-row + .sk-row { border-top: 1px solid var(--border); }
  .sk-k { font-family: var(--font-mono); font-size: .72rem; letter-spacing: .1em; text-transform: uppercase; color: var(--text-dim); margin-bottom: 10px; }
  .sk-v { display: flex; flex-wrap: wrap; gap: 6px; }
  @media (max-width: 900px) { .about { grid-template-columns: 1fr; gap: 40px; } .skills { padding: 4px 18px; } }
</style>
