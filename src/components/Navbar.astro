---
const links = [
  { id: 'projects', es: 'Proyectos', en: 'Projects' },
  { id: 'ai', es: 'IA', en: 'AI' },
  { id: 'experience', es: 'Experiencia', en: 'Experience' },
  { id: 'education', es: 'Formación', en: 'Education' },
  { id: 'contact', es: 'Contacto', en: 'Contact' },
];
---

<header id="nav" class="nav">
  <div class="container nav-inner">
    <a href="#top" class="brand" aria-label="Edwin Velásquez — inicio">
      <span class="brand-logo" aria-hidden="true"><span class="lt">&lt;</span><span class="ev">EV</span><span class="gt">/&gt;</span></span>
    </a>

    <nav class="nav-links" aria-label="Principal">
      {links.map((l) => (
        <a href={`#${l.id}`} data-nav={l.id}><span class="es-only">{l.es}</span><span class="en-only">{l.en}</span></a>
      ))}
    </nav>

    <div class="nav-actions">
      <div class="lang" role="group" aria-label="Idioma / Language">
        <button type="button" data-set-lang="es">ES</button>
        <button type="button" data-set-lang="en">EN</button>
      </div>
      <a href="/edwinVelasquezCV.pdf" download class="btn btn-ghost btn-sm nav-cv">CV</a>
      <button class="burger" id="burger" aria-label="Menú" aria-expanded="false" aria-controls="mobileMenu">
        <span></span><span></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobileMenu">
    {links.map((l) => (
      <a href={`#${l.id}`}><span class="es-only">{l.es}</span><span class="en-only">{l.en}</span></a>
    ))}
    <a href="/edwinVelasquezCV.pdf" download class="btn btn-primary" style="margin-top:12px">
      <span class="es-only">Descargar CV</span><span class="en-only">Download CV</span>
    </a>
  </div>
</header>

<style>
  .nav { position: fixed; inset: 0 0 auto 0; z-index: 50; transition: background .3s, border-color .3s, backdrop-filter .3s; border-bottom: 1px solid transparent; }
  .nav.scrolled { background: rgba(6, 8, 13, .72); backdrop-filter: blur(14px) saturate(140%); border-color: var(--border); }
  .nav-inner { height: 68px; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; }
  .brand-logo { display: inline-flex; align-items: baseline; font-family: var(--font-mono); font-weight: 500; font-size: 1.3rem; letter-spacing: -.02em; line-height: 1; }
  .brand-logo .ev { color: var(--text); font-weight: 700; padding: 0 .08em; }
  .brand-logo .lt, .brand-logo .gt { color: var(--accent); transition: transform .35s var(--ease); display: inline-block; }
  .brand:hover .lt { transform: translateX(-3px); }
  .brand:hover .gt { transform: translateX(3px); }
  .nav-links { display: flex; gap: 4px; }
  .nav-links a { text-decoration: none; color: var(--text-muted); font-size: .9rem; font-weight: 500; padding: 8px 14px; border-radius: 999px; transition: color .2s, background .2s; }
  .nav-links a:hover { color: var(--text); }
  .nav-links a.active { color: var(--text); background: rgba(255, 255, 255, .06); }
  .nav-actions { display: flex; align-items: center; gap: 10px; }
  .lang { display: flex; padding: 3px; border-radius: 999px; border: 1px solid var(--border); background: rgba(255, 255, 255, .02); }
  .lang button { border: 0; background: transparent; color: var(--text-dim); font-family: var(--font-mono); font-size: .72rem; padding: 5px 9px; border-radius: 999px; cursor: pointer; }
  .lang button[aria-pressed='true'] { background: rgba(255, 255, 255, .09); color: var(--text); }
  .burger { display: none; width: 40px; height: 40px; border-radius: 12px; border: 1px solid var(--border); background: transparent; cursor: pointer; flex-direction: column; justify-content: center; align-items: center; gap: 6px; }
  .burger span { width: 16px; height: 1.5px; background: var(--text); transition: transform .3s var(--ease); }
  .nav.open .burger span:first-child { transform: translateY(3.75px) rotate(45deg); }
  .nav.open .burger span:last-child { transform: translateY(-3.75px) rotate(-45deg); }
  .mobile-menu { display: none; }
  @media (max-width: 860px) {
    .nav-links, .nav-cv { display: none; }
    .burger { display: flex; }
    .mobile-menu { display: flex; flex-direction: column; gap: 2px; padding: 0 16px; max-height: 0; overflow: hidden; transition: max-height .4s var(--ease), padding .4s var(--ease); background: rgba(6, 8, 13, .96); backdrop-filter: blur(14px); }
    .mobile-menu a:not(.btn) { padding: 13px 4px; text-decoration: none; font-family: var(--font-display); font-size: 1.15rem; border-bottom: 1px solid var(--border); }
    .nav.open { background: rgba(6, 8, 13, .96); border-color: var(--border); }
    .nav.open .mobile-menu { max-height: 460px; padding: 8px 16px 22px; }
  }
</style>

<script>
  const nav = document.getElementById('nav')!;
  const burger = document.getElementById('burger')!;
  const onScroll = () => nav.classList.toggle('scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
  burger.addEventListener('click', () => {
    const open = nav.classList.toggle('open');
    burger.setAttribute('aria-expanded', String(open));
  });
  document.querySelectorAll('#mobileMenu a').forEach((a) => a.addEventListener('click', () => {
    nav.classList.remove('open'); burger.setAttribute('aria-expanded', 'false');
  }));
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-nav]');
  const spy = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      if (e.isIntersecting) links.forEach((l) => l.classList.toggle('active', l.dataset.nav === e.target.id));
    });
  }, { rootMargin: '-45% 0px -50% 0px' });
  ['top', 'about', ...Array.from(links).map((l) => l.dataset.nav!)].forEach((id) => {
    const s = document.getElementById(id); if (s) spy.observe(s);
  });
</script>
