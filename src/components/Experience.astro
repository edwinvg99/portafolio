---
const jobs = [
  {
    role: { es: 'Fundador y desarrollador Full Stack', en: 'Founder & Full Stack Developer' },
    company: 'CamMetrics · SaaS',
    period: { es: '2026 — Presente', en: '2026 — Present' },
    bullets: {
      es: [
        'Diseño y construcción de un SaaS de analítica en tiempo real: web en Next.js, worker 24/7 y PostgreSQL en Railway.',
        'Suscripciones con pasarela de pagos, alertas por Telegram, cifrado de credenciales y observabilidad (Sentry, PostHog).',
      ],
      en: [
        'Designed and built a real-time analytics SaaS: Next.js web app, 24/7 worker and PostgreSQL on Railway.',
        'Subscriptions with a payment gateway, Telegram alerts, credential encryption and observability (Sentry, PostHog).',
      ],
    },
    tags: ['Next.js', 'TypeScript', 'PostgreSQL', 'Prisma'],
  },
  {
    role: { es: 'Desarrollador Full Stack y Automatización', en: 'Full Stack & Automation Developer' },
    company: 'El Derecho Para Todos',
    period: { es: 'Jun. 2025 — Presente', en: 'Jun 2025 — Present' },
    bullets: {
      es: [
        'CodeLegal: e-commerce de cursos con más de 2.000 usuarios y 3.000 matrículas; migración desde la plataforma anterior sin pérdida de datos.',
        'Aula Virtual PGN para el concurso de la Procuraduría (clases, simulacros, panel de seguimiento) y Academia GOBERNAR (diplomados, masterclasses y admisiones).',
        'Automatización de procesos administrativos, paneles internos y despliegues en Railway y Cloudflare.',
      ],
      en: [
        'CodeLegal: course e-commerce with 2,000+ users and 3,000+ enrollments; migrated from the previous platform with zero data loss.',
        'PGN Virtual Classroom for the Inspector General’s Office exam (classes, mock exams, tracking dashboard) and the GOBERNAR Academy (programs, masterclasses and admissions).',
        'Automation of administrative processes, internal dashboards and deployments on Railway and Cloudflare.',
      ],
    },
    tags: ['React', 'Node.js', 'PostgreSQL', 'Next.js', 'Cloudflare R2'],
  },
  {
    role: { es: 'Desarrollador Full Stack · Campañas políticas', en: 'Full Stack Developer · Political campaigns' },
    company: { es: 'Consultoría digital', en: 'Digital consulting' },
    period: { es: '2025 — 2026', en: '2025 — 2026' },
    bullets: {
      es: [
        'Landing pages y sistemas de registro con captura de datos a escala nacional e integración con Google Sheets.',
        '“El Balón de la Gente”: concurso ciudadano para una campaña a la Alcaldía de Itagüí, con inscripción, carga de videos y panel.',
      ],
      en: [
        'Landing pages and nationwide sign-up systems integrated with Google Sheets.',
        '“El Balón de la Gente”: a citizen contest for an Itagüí mayoral campaign, with sign-up, video uploads and admin panel.',
      ],
    },
    tags: ['Node.js', 'Express', 'PostgreSQL', 'Google Sheets API'],
  },
  {
    role: { es: 'Desarrollador Full Stack freelance', en: 'Freelance Full Stack Developer' },
    company: { es: 'Proyectos independientes', en: 'Independent projects' },
    period: { es: '2022 — Presente', en: '2022 — Present' },
    bullets: {
      es: [
        'Del Campo POS: punto de venta, inventario y tienda online para un restaurante en Bogotá.',
        'Sitios, dashboards y automatizaciones para pequeñas empresas y emprendedores.',
      ],
      en: [
        'Del Campo POS: point of sale, inventory and online store for a restaurant in Bogotá.',
        'Websites, dashboards and automations for small businesses and entrepreneurs.',
      ],
    },
    tags: ['Next.js', 'Drizzle', 'Python', 'Django'],
  },
  {
    role: { es: 'Practicante de Soporte TI', en: 'IT Support Intern' },
    company: 'Algar Tech — SAP SURA',
    period: { es: '2023', en: '2023' },
    bullets: {
      es: ['Gestión de incidentes de plataformas SAP, documentación y escalamiento en un entorno corporativo.'],
      en: ['SAP platform incident management, documentation and escalation in a corporate environment.'],
    },
    tags: ['SAP', 'Service Desk'],
  },
];
const tx = (v: any, l: 'es' | 'en') => (typeof v === 'string' ? v : v[l]);
---

<section id="experience">
  <div class="container exp">
    <header class="reveal exp-head">
      <p class="eyebrow"><span class="es-only">Experiencia</span><span class="en-only">Experience</span></p>
      <h2 class="h2"><span class="es-only">Dónde he construido.</span><span class="en-only">Where I've built.</span></h2>
      <p class="lead"><span class="es-only">Experiencia combinando empleo, clientes propios y producto propio.</span><span class="en-only">A mix of employment, my own clients and my own product.</span></p>
    </header>

    <ol class="timeline">
      {jobs.map((j) => (
        <li class="job reveal">
          <div class="when">{j.period.es === j.period.en ? j.period.es : <><span class="es-only">{j.period.es}</span><span class="en-only">{j.period.en}</span></>}</div>
          <div class="what">
            <h3><span class="es-only">{j.role.es}</span><span class="en-only">{j.role.en}</span></h3>
            <p class="company"><span class="es-only">{tx(j.company, 'es')}</span><span class="en-only">{tx(j.company, 'en')}</span></p>
            <ul>
              {j.bullets.es.map((b, k) => <li><span class="es-only">{b}</span><span class="en-only">{j.bullets.en[k]}</span></li>)}
            </ul>
            <div class="tags">{j.tags.map((t) => <span class="chip">{t}</span>)}</div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .exp { display: grid; grid-template-columns: .8fr 1.6fr; gap: 64px; align-items: start; }
  .exp-head { position: sticky; top: 110px; }
  .timeline { list-style: none; position: relative; }
  .timeline::before { content: ''; position: absolute; left: 0; top: 8px; bottom: 8px; width: 1px; background: linear-gradient(var(--cyan), var(--violet) 60%, transparent); opacity: .5; }
  .job { position: relative; display: grid; grid-template-columns: 150px 1fr; gap: 24px; padding: 0 0 44px 28px; }
  .job::before { content: ''; position: absolute; left: -4px; top: 8px; width: 9px; height: 9px; border-radius: 50%; background: var(--bg); border: 2px solid var(--cyan); }
  .when { font-family: var(--font-mono); font-size: .78rem; color: var(--text-dim); padding-top: 4px; }
  .what h3 { font-family: var(--font-display); font-size: 1.2rem; letter-spacing: -.01em; }
  .company { color: var(--cyan); font-size: .9rem; font-weight: 500; margin: 2px 0 12px; }
  .what ul { list-style: none; display: flex; flex-direction: column; gap: 8px; margin-bottom: 14px; }
  .what li { color: var(--text-muted); font-size: .92rem; padding-left: 16px; position: relative; }
  .what li::before { content: '–'; position: absolute; left: 0; color: var(--text-dim); }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; }
  @media (max-width: 900px) {
    .exp { grid-template-columns: 1fr; gap: 36px; }
    .exp-head { position: static; }
    .job { grid-template-columns: 1fr; gap: 6px; padding-left: 22px; }
  }
</style>
