---
import { featured, more } from '../data/projects';

const filters = [
  { id: 'all', es: 'Todos', en: 'All' },
  { id: 'client', es: 'Clientes', en: 'Clients' },
  { id: 'web', es: 'Web', en: 'Web' },
  { id: 'desktop', es: 'Escritorio', en: 'Desktop' },
  { id: 'personal', es: 'Personales', en: 'Personal' },
];
const ext = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>`;
const gh = `<svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2.2c-3.3.7-4-1.4-4-1.4-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.2-3.1-.1-.4-.5-1.6.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.6.2 2.8.1 3.2.8.8 1.2 1.9 1.2 3.1 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3"/></svg>`;
const lock = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>`;
---

<section id="projects">
  <div class="container">
    <header class="sec-head reveal">
      <p class="eyebrow"><span class="es-only">Proyectos</span><span class="en-only">Selected work</span></p>
      <h2 class="h2"><span class="es-only">Software real, usado por personas reales.</span><span class="en-only">Real software, used by real people.</span></h2>
      <p class="lead">
        <span class="es-only">Varios proyectos son de clientes o requieren inicio de sesión, así que aquí los ves por dentro con capturas y datos de demostración. Haz clic en cualquier imagen para ampliarla.</span>
        <span class="en-only">Several projects belong to clients or require a login, so you can see them from the inside here with screenshots and demo data. Click any image to enlarge it.</span>
      </p>
    </header>

    <div class="featured">
      {featured.map((p, i) => (
        <article class="case reveal" style={`--accent: ${p.accent};`} data-case>
          <div class="case-media">
            <div class="frame">
              <div class="frame-bar">
                <span class="dots"><i></i><i></i><i></i></span>
                <span class="frame-url">{p.name}</span>
                <span class="frame-count"><b data-idx>1</b>/{p.images.length}</span>
              </div>
              <div class="slides" data-slides>
                {p.images.map((src, k) => (
                  <button class="slide" data-lightbox={JSON.stringify(p.images)} data-start={k} aria-label={`${p.name} — captura ${k + 1}`}>
                    <img src={src} alt={`${p.name} — captura ${k + 1}`} loading={i < 1 && k === 0 ? 'eager' : 'lazy'} decoding="async" width="1440" height="900" />
                  </button>
                ))}
              </div>
              {p.images.length > 1 && (
                <>
                  <button class="nav-arrow prev" data-prev aria-label="Anterior"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="m15 18-6-6 6-6"/></svg></button>
                  <button class="nav-arrow next" data-next aria-label="Siguiente"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="m9 18 6-6-6-6"/></svg></button>
                </>
              )}
            </div>
            {p.images.length > 1 && (
              <div class="thumbs" data-thumbs>
                {p.images.map((src, k) => (
                  <button class={`thumb ${k === 0 ? 'on' : ''}`} data-go={k} aria-label={`Ver captura ${k + 1}`}><img src={src} alt="" loading="lazy" /></button>
                ))}
              </div>
            )}
          </div>

          <div class="case-body">
            <p class="case-kind"><span class="es-only">{p.kind.es}</span><span class="en-only">{p.kind.en}</span></p>
            <h3 class="case-title">{p.name}</h3>
            <p class="case-meta">
              <span class="es-only">{p.role.es}</span><span class="en-only">{p.role.en}</span>
              <span class="sep">·</span>{p.year}
            </p>
            <p class="case-summary"><span class="es-only">{p.summary.es}</span><span class="en-only">{p.summary.en}</span></p>

            {p.metrics && (
              <div class="metrics">
                {p.metrics.map((m) => (
                  <div><b>{m.value}</b><span><span class="es-only">{m.label.es}</span><span class="en-only">{m.label.en}</span></span></div>
                ))}
              </div>
            )}

            <ul class="highlights">
              {p.highlights.es.map((h, k) => (
                <li><span class="es-only">{h}</span><span class="en-only">{p.highlights.en[k]}</span></li>
              ))}
            </ul>

            <div class="stack">{p.stack.map((s) => <span class="chip">{s}</span>)}</div>

            <div class="links">
              {p.github && (
                <a href={p.github} target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-sm"><Fragment set:html={gh} /> <span class="es-only">Código</span><span class="en-only">Code</span></a>
              )}
              {p.privateRepo && (
                <span class="private"><Fragment set:html={lock} /> <span class="es-only">Código privado · demo en entrevista</span><span class="en-only">Private code · demo on request</span></span>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>

    <header class="sec-head more-head reveal">
      <h3 class="h3"><span class="es-only">Más proyectos</span><span class="en-only">More projects</span></h3>
      <div class="filters" role="group" aria-label="Filtrar">
        {filters.map((f, k) => (
          <button class={`filter ${k === 0 ? 'on' : ''}`} data-filter={f.id}><span class="es-only">{f.es}</span><span class="en-only">{f.en}</span></button>
        ))}
      </div>
    </header>

    <div class="more-grid">
      {more.map((p) => (
        <article class="mini card reveal" style={`--accent: ${p.accent};`} data-tags={p.tags.join(' ')}>
          <button class="mini-media" data-lightbox={JSON.stringify(p.images)} data-start="0" aria-label={`Ver capturas de ${p.name}`}>
            <img src={p.images[0]} alt={`${p.name} — captura`} loading="lazy" decoding="async" />
            {p.images.length > 1 && <span class="mini-count">{p.images.length} <span class="es-only">capturas</span><span class="en-only">shots</span></span>}
          </button>
          <div class="mini-body">
            <p class="case-kind"><span class="es-only">{p.kind.es}</span><span class="en-only">{p.kind.en}</span></p>
            <h4 class="mini-title">{p.name}</h4>
            <p class="mini-summary"><span class="es-only">{p.summary.es}</span><span class="en-only">{p.summary.en}</span></p>
            <div class="stack">{p.stack.slice(0, 5).map((s) => <span class="chip">{s}</span>)}</div>
            <div class="links">
              {p.github && <a href={p.github} target="_blank" rel="noopener noreferrer" class="lnk"><Fragment set:html={gh} /> <span class="es-only">Ver código</span><span class="en-only">View code</span></a>}
              {!p.github && (p.tags.includes('desktop')
                ? <span class="private"><Fragment set:html={lock} /> <span class="es-only">App de escritorio · demo en entrevista</span><span class="en-only">Desktop app · demo on request</span></span>
                : <span class="private"><Fragment set:html={lock} /> <span class="es-only">Proyecto de cliente · demo en entrevista</span><span class="en-only">Client project · demo on request</span></span>)}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<dialog id="lightbox" class="lightbox" aria-label="Galería">
  <button class="lb-close" data-lb-close aria-label="Cerrar">✕</button>
  <button class="lb-arrow lb-prev" data-lb-prev aria-label="Anterior"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="m15 18-6-6 6-6"/></svg></button>
  <img id="lbImg" alt="" />
  <button class="lb-arrow lb-next" data-lb-next aria-label="Siguiente"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="m9 18 6-6-6-6"/></svg></button>
  <p class="lb-count" id="lbCount"></p>
</dialog>

<style>
  .sec-head { margin-bottom: 64px; }
  .featured { display: flex; flex-direction: column; gap: 120px; }
  .case { display: grid; grid-template-columns: 1.25fr 1fr; gap: 56px; align-items: start; }
  .case:nth-child(even) .case-media { order: 2; }
  .case-media { position: sticky; top: 96px; }

  .frame { position: relative; border-radius: 16px; overflow: hidden; background: #0b0f17; border: 1px solid var(--border-strong); box-shadow: 0 50px 100px -40px color-mix(in srgb, var(--accent) 35%, transparent), 0 30px 60px -30px rgba(0, 0, 0, .8); }
  .frame-bar { display: flex; align-items: center; gap: 12px; height: 38px; padding: 0 14px; background: #0f141e; border-bottom: 1px solid var(--border); }
  .dots { display: flex; gap: 6px; } .dots i { width: 10px; height: 10px; border-radius: 50%; background: #2a3342; }
  .frame-url { flex: 1; text-align: center; font-family: var(--font-mono); font-size: .72rem; color: var(--text-dim); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .frame-count { font-family: var(--font-mono); font-size: .72rem; color: var(--text-dim); }
  .frame-count b { color: var(--text); font-weight: 500; }
  .slides { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; aspect-ratio: 16/10; }
  .slides::-webkit-scrollbar { display: none; }
  .slide { flex: 0 0 100%; scroll-snap-align: start; border: 0; padding: 0; background: #0b0f17; cursor: zoom-in; display: grid; place-items: center; }
  .slide img { width: 100%; height: 100%; object-fit: cover; object-position: top center; }
  .nav-arrow { position: absolute; top: 50%; translate: 0 -30%; width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--border-strong); background: rgba(6, 8, 13, .7); backdrop-filter: blur(8px); color: var(--text); cursor: pointer; display: grid; place-items: center; opacity: 0; transition: opacity .25s, background .2s; }
  .frame:hover .nav-arrow, .nav-arrow:focus-visible { opacity: 1; }
  .nav-arrow:hover { background: rgba(6, 8, 13, .95); }
  .prev { left: 12px; } .next { right: 12px; }
  .thumbs { display: flex; gap: 8px; margin-top: 12px; }
  .thumb { flex: 1; max-width: 110px; aspect-ratio: 16/10; border-radius: 8px; overflow: hidden; border: 1px solid var(--border); padding: 0; background: #0b0f17; cursor: pointer; opacity: .45; transition: opacity .2s, border-color .2s; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; object-position: top; }
  .thumb:hover { opacity: .8; }
  .thumb.on { opacity: 1; border-color: var(--accent); }

  .case-kind { font-family: var(--font-mono); font-size: .74rem; letter-spacing: .08em; text-transform: uppercase; color: var(--accent); margin-bottom: 10px; }
  .case-title { font-family: var(--font-display); font-size: clamp(1.8rem, 3vw, 2.4rem); font-weight: 700; letter-spacing: -.03em; line-height: 1.05; margin-bottom: 8px; }
  .case-meta { color: var(--text-dim); font-size: .86rem; margin-bottom: 18px; }
  .sep { margin: 0 8px; }
  .case-summary { color: var(--text-muted); font-size: 1rem; margin-bottom: 22px; }
  .metrics { display: flex; gap: 28px; margin-bottom: 22px; padding: 16px 0; border-block: 1px solid var(--border); }
  .metrics div { display: flex; flex-direction: column; }
  .metrics b { font-family: var(--font-display); font-size: 1.7rem; letter-spacing: -.02em; line-height: 1.1; }
  .metrics span { color: var(--text-dim); font-size: .78rem; }
  .highlights { list-style: none; display: flex; flex-direction: column; gap: 10px; margin-bottom: 24px; }
  .highlights li { position: relative; padding-left: 22px; color: var(--text-muted); font-size: .93rem; line-height: 1.55; }
  .highlights li::before { content: ''; position: absolute; left: 2px; top: .62em; width: 8px; height: 8px; border-radius: 2px; background: var(--accent); opacity: .85; rotate: 45deg; }
  .stack { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 22px; }
  .links { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  .note { font-size: .7rem; color: var(--text-dim); font-weight: 500; padding-left: 8px; margin-left: 2px; border-left: 1px solid var(--border-strong); }
  .private { display: inline-flex; align-items: center; gap: 6px; color: var(--text-dim); font-size: .8rem; }

  .more-head { display: flex; align-items: end; justify-content: space-between; gap: 20px; flex-wrap: wrap; margin: 140px 0 32px; }
  .h3 { font-family: var(--font-display); font-size: clamp(1.6rem, 3vw, 2.1rem); letter-spacing: -.03em; }
  .filters { display: flex; flex-wrap: wrap; gap: 6px; }
  .filter { border: 1px solid var(--border); background: transparent; color: var(--text-muted); padding: 7px 14px; border-radius: 999px; font-size: .84rem; cursor: pointer; transition: all .2s; }
  .filter:hover { color: var(--text); border-color: var(--border-strong); }
  .filter.on { background: var(--text); color: #05070b; border-color: var(--text); }
  .more-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .more-grid > .mini:last-child:nth-child(3n + 1) { grid-column: 2; }
  .mini { overflow: hidden; display: flex; flex-direction: column; transition: transform .35s var(--ease), border-color .35s; }
  .mini:hover { transform: translateY(-4px); border-color: color-mix(in srgb, var(--accent) 45%, transparent); }
  .mini[hidden] { display: none; }
  .mini-media { position: relative; aspect-ratio: 16/10; overflow: hidden; border: 0; padding: 0; background: #0b0f17; cursor: zoom-in; border-bottom: 1px solid var(--border); }
  .mini-media img { width: 100%; height: 100%; object-fit: cover; object-position: top; transition: transform .6s var(--ease); }
  .mini:hover .mini-media img { transform: scale(1.04); }
  .mini-count { position: absolute; right: 10px; bottom: 10px; font-size: .72rem; padding: 4px 9px; border-radius: 999px; background: rgba(6, 8, 13, .8); border: 1px solid var(--border-strong); color: var(--text-muted); }
  .mini-body { padding: 20px; display: flex; flex-direction: column; flex: 1; }
  .mini-title { font-family: var(--font-display); font-size: 1.3rem; letter-spacing: -.02em; margin-bottom: 8px; }
  .mini-summary { color: var(--text-muted); font-size: .88rem; margin-bottom: 16px; flex: 1; }
  .mini .stack { margin-bottom: 16px; }
  .lnk { display: inline-flex; align-items: center; gap: 6px; font-size: .84rem; font-weight: 600; text-decoration: none; color: var(--text); padding: 4px 0; border-bottom: 1px solid transparent; }
  .lnk:hover { border-color: var(--accent); }

  .lightbox { position: fixed; inset: 0; width: 100vw; height: 100dvh; max-width: none; max-height: none; border: 0; padding: 0; background: rgba(3, 5, 9, .94); color: var(--text); display: none; place-items: center; }
  .lightbox[open] { display: grid; }
  .lightbox::backdrop { background: transparent; }
  .lightbox img { max-width: min(92vw, 1600px); max-height: 84dvh; border-radius: 12px; border: 1px solid var(--border-strong); object-fit: contain; box-shadow: 0 40px 120px rgba(0, 0, 0, .7); }
  .lb-close, .lb-arrow { position: absolute; border: 1px solid var(--border-strong); background: rgba(14, 20, 32, .8); color: var(--text); border-radius: 50%; cursor: pointer; display: grid; place-items: center; }
  .lb-close { top: 18px; right: 18px; width: 44px; height: 44px; font-size: 1rem; }
  .lb-arrow { top: 50%; translate: 0 -50%; width: 52px; height: 52px; }
  .lb-prev { left: 18px; } .lb-next { right: 18px; }
  .lb-count { position: absolute; bottom: 20px; left: 50%; translate: -50% 0; font-family: var(--font-mono); font-size: .8rem; color: var(--text-muted); }

  @media (max-width: 980px) {
    .case { grid-template-columns: 1fr; gap: 28px; }
    .case:nth-child(even) .case-media { order: 0; }
    .case-media { position: static; }
    .featured { gap: 88px; }
    .more-grid { grid-template-columns: repeat(2, 1fr); }
    .more-grid > .mini:last-child:nth-child(3n + 1) { grid-column: auto; }
    .more-grid > .mini:last-child:nth-child(odd) { grid-column: 1 / -1; max-width: calc(50% - 10px); justify-self: center; }
    .nav-arrow { opacity: 1; }
  }
  @media (max-width: 640px) {
    .more-grid { grid-template-columns: 1fr; }
    .more-grid > .mini:last-child:nth-child(odd) { max-width: none; }
    .thumbs { display: none; }
    .metrics { gap: 20px; }
    .lb-arrow { top: auto; bottom: 14px; translate: none; width: 44px; height: 44px; }
    .lb-count { bottom: 28px; }
  }
</style>

<script>
  // ── per-case carousel ────────────────────────────────
  document.querySelectorAll<HTMLElement>('[data-case]').forEach((c) => {
    const track = c.querySelector<HTMLElement>('[data-slides]')!;
    const n = track.children.length;
    const idxEl = c.querySelector<HTMLElement>('[data-idx]');
    const thumbs = Array.from(c.querySelectorAll<HTMLElement>('[data-go]'));
    const cur = () => Math.round(track.scrollLeft / track.clientWidth);
    const go = (i: number) => track.scrollTo({ left: ((i + n) % n) * track.clientWidth, behavior: 'smooth' });
    const sync = () => {
      const i = cur();
      if (idxEl) idxEl.textContent = String(i + 1);
      thumbs.forEach((t, k) => t.classList.toggle('on', k === i));
    };
    track.addEventListener('scroll', () => requestAnimationFrame(sync), { passive: true });
    c.querySelector('[data-prev]')?.addEventListener('click', () => go(cur() - 1));
    c.querySelector('[data-next]')?.addEventListener('click', () => go(cur() + 1));
    thumbs.forEach((t) => t.addEventListener('click', () => go(Number(t.dataset.go))));

    // gentle autoplay while visible, paused on hover/focus
    let timer: number | undefined, hover = false;
    const media = c.querySelector<HTMLElement>('.case-media')!;
    media.addEventListener('mouseenter', () => (hover = true));
    media.addEventListener('mouseleave', () => (hover = false));
    if (n > 1 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      new IntersectionObserver(([e]) => {
        clearInterval(timer);
        if (e.isIntersecting) timer = window.setInterval(() => { if (!hover && !document.hidden) go(cur() + 1); }, 4200);
      }, { threshold: 0.5 }).observe(track);
    }
  });

  // ── filters ──────────────────────────────────────────
  const btns = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  btns.forEach((b) => b.addEventListener('click', () => {
    btns.forEach((x) => x.classList.toggle('on', x === b));
    const f = b.dataset.filter!;
    document.querySelectorAll<HTMLElement>('[data-tags]').forEach((card) => {
      card.hidden = f !== 'all' && !card.dataset.tags!.split(' ').includes(f);
    });
  }));

  // ── lightbox ─────────────────────────────────────────
  const lb = document.getElementById('lightbox') as HTMLDialogElement;
  const img = document.getElementById('lbImg') as HTMLImageElement;
  const count = document.getElementById('lbCount')!;
  let list: string[] = [], at = 0;
  const show = () => { img.src = list[at]; count.textContent = `${at + 1} / ${list.length}`; lb.querySelectorAll<HTMLElement>('.lb-arrow').forEach((a) => (a.hidden = list.length < 2)); };
  document.addEventListener('click', (ev) => {
    const t = (ev.target as HTMLElement).closest<HTMLElement>('[data-lightbox]');
    if (!t) return;
    list = JSON.parse(t.dataset.lightbox!); at = Number(t.dataset.start || 0);
    show(); lb.showModal(); document.body.style.overflow = 'hidden';
  });
  const close = () => { lb.close(); };
  lb.addEventListener('close', () => { document.body.style.overflow = ''; });
  lb.querySelector('[data-lb-close]')!.addEventListener('click', close);
  lb.querySelector('[data-lb-prev]')!.addEventListener('click', () => { at = (at - 1 + list.length) % list.length; show(); });
  lb.querySelector('[data-lb-next]')!.addEventListener('click', () => { at = (at + 1) % list.length; show(); });
  lb.addEventListener('click', (e) => { if (e.target === lb) close(); });
  document.addEventListener('keydown', (e) => {
    if (!lb.open) return;
    if (e.key === 'ArrowRight') { at = (at + 1) % list.length; show(); }
    if (e.key === 'ArrowLeft') { at = (at - 1 + list.length) % list.length; show(); }
  });
</script>
